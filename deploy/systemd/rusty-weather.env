# Install as /etc/default/rusty-weather with mode 0640, owned by root:rusty-weather.
RW_LISTEN=127.0.0.1:8788
RW_STORE_ROOT=/var/lib/rusty-weather/store
RW_ARTIFACT_ROOT=/var/lib/rusty-weather/artifacts
RW_CACHE_ROOT=/var/cache/rusty-weather/server
RW_OPERATIONS_ROOT=/var/lib/rusty-weather/operations
RW_API_TOKEN_FILE=/etc/rusty-weather/api-tokens.txt
RW_LOG=rw_server=info,tower_http=info

# Enabling the MRMS follower also requires the reviewed writable-store drop-in.
# RW_MRMS_INGEST_ENABLED=true

# Optional distributed features remain off unless their TOML gates, audited
# limits, and secret files are also configured. These paths keep mutable state
# under the systemd-managed service root without making the model store writable.
# RW_COMMUNITY_ROOT=/var/lib/rusty-weather/community-cache
# RW_GENERATION_REPLICATION_ROOT=/var/lib/rusty-weather/generation-replication
# RW_OPERATIONS_ENABLED=true
# Owner-mapped per-user credentials: <owner-id><TAB><bearer-token>, mode 0600.
# RW_OPS_WRITE_TOKEN_FILE=/etc/rusty-weather/ops-write-tokens.txt
# Legacy compatibility only; never enable for general API data tokens.
# RW_LEGACY_API_TOKENS_ARE_OPERATIONS_ADMINS=false
