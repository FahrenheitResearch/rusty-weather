# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d
WORKDIR /app
COPY deploy/cloudflare-r2-gateway/package.json deploy/cloudflare-r2-gateway/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force
COPY deploy/cloudflare-r2-gateway/src ./src
COPY deploy/cloudflare-r2-gateway/wrangler.jsonc ./wrangler.jsonc
USER 65532:65532
EXPOSE 443
CMD ["./node_modules/.bin/wrangler", "dev", "--local", "--ip", "0.0.0.0", "--port", "443", "--local-protocol", "https", "--https-key-path", "/run/secrets/lab_tls_private_key", "--https-cert-path", "/run/secrets/lab_tls_certificate", "--persist-to", "/data", "--log-level", "warn", "--var", "WRITE_BEARER_TOKEN:distributed-lab-r2-write-token-0001"]
