{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppConfig",
  "type": "object",
  "properties": {
    "auth": {
      "$ref": "#/$defs/AuthConfig",
      "default": {
        "protect_metrics": true,
        "token_file": null
      }
    },
    "catalog": {
      "$ref": "#/$defs/CatalogConfig",
      "default": {
        "response_cache_seconds": 300
      }
    },
    "community": {
      "description": "Optional, privacy-preserving Community Cache. This is disabled unless\nan operator explicitly enables it and supplies signing material.",
      "$ref": "#/$defs/CommunityConfig",
      "default": {
        "capacity_audit_completed": false,
        "cases": {
          "artifact_publication_enabled": false,
          "default_retention_seconds": 2592000,
          "enabled": false,
          "full_run_replication_enabled": false,
          "maximum_cases": 1000,
          "maximum_manifest_bytes": 262144,
          "maximum_objects_per_case": 512,
          "storage_bytes": 268435456
        },
        "enabled": false,
        "hot_store": {
          "provider": "disabled"
        },
        "kill_switch": false,
        "origin_base_url": null,
        "origin_token_file": null,
        "promotion": {
          "enabled": false,
          "maximum_object_bytes": 67108864,
          "minimum_hits": 3,
          "window_seconds": 300
        },
        "quotas": {
          "concurrent_transfers": 4,
          "download_bytes_per_month": 107374182400,
          "maximum_decompressed_bytes": 268435456,
          "maximum_manifest_bytes": 262144,
          "maximum_object_bytes": 67108864,
          "maximum_objects": 100000,
          "maximum_principals": 10000,
          "promoted_bytes_per_month": 107374182400,
          "storage_bytes": 10737418240,
          "upload_bytes_per_month": 107374182400
        },
        "root": "./community-cache",
        "signing_key_file": null,
        "trusted_public_keys": []
      }
    },
    "federation": {
      "description": "Operator-approved public university/lab/service origins. This is a\nconventional HTTPS federation, not ordinary-client peer discovery.",
      "$ref": "#/$defs/FederationConfig",
      "default": {
        "approved_origins": [],
        "catalog_id": "fahrenheit-public-origins",
        "catalog_signing_key_file": null,
        "catalog_signing_key_id": "federation-catalog-v1",
        "catalog_ttl_seconds": 300,
        "descriptor_files": [],
        "enabled": false,
        "health_connect_timeout_seconds": 3,
        "health_failure_threshold": 3,
        "health_global_timeout_seconds": 8,
        "health_monitor_enabled": false,
        "health_probe_concurrency": 4,
        "health_probe_interval_seconds": 30,
        "health_quarantine_seconds": 60,
        "health_receive_timeout_seconds": 4,
        "health_resolve_timeout_seconds": 2,
        "health_send_timeout_seconds": 2,
        "health_state_file": null,
        "maximum_selection_results": 8,
        "revoked_key_ids": [],
        "revoked_origin_ids": []
      }
    },
    "limits": {
      "$ref": "#/$defs/LimitsConfig",
      "default": {
        "catalog_time_points": 10000,
        "geographic_window_cells": 250000,
        "geographic_window_output_values": 2000000,
        "heavy_concurrency": 2,
        "job_history_records": 10000,
        "job_result_bytes": 536870912,
        "job_retention_seconds": 604800,
        "job_timeout_seconds": 300,
        "json_grid_values": 250000,
        "light_concurrency": 32,
        "points_per_query": 100,
        "queued_jobs": 64,
        "reader_cache_bytes": 268435456,
        "request_body_bytes": 2097152,
        "response_cache_bytes": 134217728,
        "sync_result_values": 2000000,
        "sync_timeout_seconds": 10,
        "temporal_frames": 120,
        "temporal_output_values": 32000000,
        "temporal_reduction_cells": 4000000,
        "variables_per_query": 32
      }
    },
    "logging": {
      "$ref": "#/$defs/LoggingConfig",
      "default": {
        "filter": "rw_server=info,tower_http=info",
        "format": "json"
      }
    },
    "server": {
      "$ref": "#/$defs/ServerConfig",
      "default": {
        "allow_unauthenticated_public_bind": false,
        "artifact_root": "./artifacts",
        "cors_origins": [],
        "listen": "127.0.0.1:8788",
        "store_root": "./store"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ApprovedFederationOriginConfig": {
      "type": "object",
      "properties": {
        "descriptor_signing_keys": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FederationTrustedKeyConfig"
          }
        },
        "health_bearer_token_file": {
          "description": "Optional permission-restricted bearer token file for this public\norigin's same-origin health endpoint. Tokens are never accepted inline.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "origin_id": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "AuthConfig": {
      "type": "object",
      "properties": {
        "protect_metrics": {
          "type": "boolean",
          "default": true
        },
        "token_file": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "CaseRoomConfig": {
      "type": "object",
      "properties": {
        "artifact_publication_enabled": {
          "description": "Separate opt-in gate for authenticated typed artifact publication.\nRaw files, directories, wrfout, and complete-run uploads remain outside\nthis endpoint regardless of this setting.",
          "type": "boolean",
          "default": false
        },
        "default_retention_seconds": {
          "description": "Maximum requested retention interval for a published case.",
          "type": "integer",
          "format": "uint64",
          "default": 2592000,
          "minimum": 0
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "full_run_replication_enabled": {
          "description": "Reserved contract gate for a later typed `.rws` generation replication\nservice. No current HTTP route consumes it and it must remain false.",
          "type": "boolean",
          "default": false
        },
        "maximum_cases": {
          "description": "Total number of unexpired case manifests retained locally.",
          "type": "integer",
          "format": "uint",
          "default": 1000,
          "minimum": 0
        },
        "maximum_manifest_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 262144,
          "minimum": 0
        },
        "maximum_objects_per_case": {
          "type": "integer",
          "format": "uint",
          "default": 512,
          "minimum": 0
        },
        "storage_bytes": {
          "description": "Total encoded bytes available to unexpired case manifests.",
          "type": "integer",
          "format": "uint64",
          "default": 268435456,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "CatalogConfig": {
      "type": "object",
      "properties": {
        "response_cache_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "CommunityConfig": {
      "description": "Phase-one Community Cache configuration. Capacity values intentionally\nremain conservative and operator-configurable until the deployment host is\naudited. Enabling this does not enable any peer transport.",
      "type": "object",
      "properties": {
        "capacity_audit_completed": {
          "description": "Explicit acknowledgement that deployment-specific disk/concurrency\ncapacity values came from the completed origin-host audit.",
          "type": "boolean",
          "default": false
        },
        "cases": {
          "$ref": "#/$defs/CaseRoomConfig",
          "default": {
            "artifact_publication_enabled": false,
            "default_retention_seconds": 2592000,
            "enabled": false,
            "full_run_replication_enabled": false,
            "maximum_cases": 1000,
            "maximum_manifest_bytes": 262144,
            "maximum_objects_per_case": 512,
            "storage_bytes": 268435456
          }
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "hot_store": {
          "$ref": "#/$defs/HotStoreConfig",
          "default": {
            "provider": "disabled"
          }
        },
        "kill_switch": {
          "description": "Immediate server-side stop for assisted cache reads, publication, and\npromotion. Signed conventional HTTPS-origin resolution remains live.",
          "type": "boolean",
          "default": false
        },
        "origin_base_url": {
          "description": "Normal HTTPS Hetzner/origin fallback. Mutable aliases are not allowed.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "origin_token_file": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "promotion": {
          "$ref": "#/$defs/PromotionConfig",
          "default": {
            "enabled": false,
            "maximum_object_bytes": 67108864,
            "minimum_hits": 3,
            "window_seconds": 300
          }
        },
        "quotas": {
          "$ref": "#/$defs/CommunityQuotasConfig",
          "default": {
            "concurrent_transfers": 4,
            "download_bytes_per_month": 107374182400,
            "maximum_decompressed_bytes": 268435456,
            "maximum_manifest_bytes": 262144,
            "maximum_object_bytes": 67108864,
            "maximum_objects": 100000,
            "maximum_principals": 10000,
            "promoted_bytes_per_month": 107374182400,
            "storage_bytes": 10737418240,
            "upload_bytes_per_month": 107374182400
          }
        },
        "root": {
          "type": "string",
          "default": "./community-cache"
        },
        "signing_key_file": {
          "description": "File containing a private manifest-signing key. Never accepted inline.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "trusted_public_keys": {
          "description": "Public verification keys accepted for origin and hot-store manifests.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "CommunityQuotasConfig": {
      "type": "object",
      "properties": {
        "concurrent_transfers": {
          "type": "integer",
          "format": "uint",
          "default": 4,
          "minimum": 0
        },
        "download_bytes_per_month": {
          "type": "integer",
          "format": "uint64",
          "default": 107374182400,
          "minimum": 0
        },
        "maximum_decompressed_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 268435456,
          "minimum": 0
        },
        "maximum_manifest_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 262144,
          "minimum": 0
        },
        "maximum_object_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 67108864,
          "minimum": 0
        },
        "maximum_objects": {
          "type": "integer",
          "format": "uint",
          "default": 100000,
          "minimum": 0
        },
        "maximum_principals": {
          "description": "Maximum distinct authenticated principals retained in the durable\nmonthly accounting file. A new principal fails closed at this bound.",
          "type": "integer",
          "format": "uint",
          "default": 10000,
          "minimum": 0
        },
        "promoted_bytes_per_month": {
          "description": "Global cost ceiling for bytes promoted to the hot-object provider.",
          "type": "integer",
          "format": "uint64",
          "default": 107374182400,
          "minimum": 0
        },
        "storage_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 10737418240,
          "minimum": 0
        },
        "upload_bytes_per_month": {
          "type": "integer",
          "format": "uint64",
          "default": 107374182400,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "FederationConfig": {
      "type": "object",
      "properties": {
        "approved_origins": {
          "description": "Explicit identity/key allowlist established out of band.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ApprovedFederationOriginConfig"
          }
        },
        "catalog_id": {
          "type": "string",
          "default": "fahrenheit-public-origins"
        },
        "catalog_signing_key_file": {
          "description": "Private Ed25519 catalog key. It is loaded from a permission-restricted\nfile and is never accepted inline or emitted by configuration APIs.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "catalog_signing_key_id": {
          "type": "string",
          "default": "federation-catalog-v1"
        },
        "catalog_ttl_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 0
        },
        "descriptor_files": {
          "description": "Signed descriptors provisioned by an operator. There is deliberately\nno HTTP self-registration endpoint.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "health_connect_timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 3,
          "minimum": 0
        },
        "health_failure_threshold": {
          "type": "integer",
          "format": "uint32",
          "default": 3,
          "minimum": 0
        },
        "health_global_timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 8,
          "minimum": 0
        },
        "health_monitor_enabled": {
          "description": "Actively probe the signed, deliberately public origin health endpoints.\nThis remains separately disabled even when catalog federation is on.",
          "type": "boolean",
          "default": false
        },
        "health_probe_concurrency": {
          "type": "integer",
          "format": "uint",
          "default": 4,
          "minimum": 0
        },
        "health_probe_interval_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        },
        "health_quarantine_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 60,
          "minimum": 0
        },
        "health_receive_timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 4,
          "minimum": 0
        },
        "health_resolve_timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 2,
          "minimum": 0
        },
        "health_send_timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 2,
          "minimum": 0
        },
        "health_state_file": {
          "description": "Durable, address-free monitor state. Required when active monitoring is\nenabled so quarantine survives process restarts.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "maximum_selection_results": {
          "type": "integer",
          "format": "uint",
          "default": 8,
          "minimum": 0
        },
        "revoked_key_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "revoked_origin_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "FederationTrustedKeyConfig": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string",
          "default": ""
        },
        "public_key_base64": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "HotStoreConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "disabled"
            }
          },
          "required": [
            "provider"
          ]
        },
        {
          "description": "Test/local provider using the same immutable key layout as R2.",
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "filesystem"
            },
            "root": {
              "type": "string"
            }
          },
          "required": [
            "provider",
            "root"
          ]
        },
        {
          "description": "R2-compatible HTTPS object gateway. Credentials are loaded from a file,\nnever serialized in configuration or logs.",
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string"
            },
            "bucket": {
              "type": "string"
            },
            "provider": {
              "type": "string",
              "const": "r2"
            },
            "token_file": {
              "type": "string"
            }
          },
          "required": [
            "provider",
            "base_url",
            "bucket",
            "token_file"
          ]
        }
      ]
    },
    "LimitsConfig": {
      "type": "object",
      "properties": {
        "catalog_time_points": {
          "type": "integer",
          "format": "uint",
          "default": 10000,
          "minimum": 0
        },
        "geographic_window_cells": {
          "description": "Native cells in one synchronous arbitrary geographic-domain envelope.",
          "type": "integer",
          "format": "uint",
          "default": 250000,
          "minimum": 0
        },
        "geographic_window_output_values": {
          "description": "Coordinates, mask entries, and field/level values serialized by one\nsynchronous arbitrary geographic-domain response.",
          "type": "integer",
          "format": "uint",
          "default": 2000000,
          "minimum": 0
        },
        "heavy_concurrency": {
          "type": "integer",
          "format": "uint",
          "default": 2,
          "minimum": 0
        },
        "job_history_records": {
          "type": "integer",
          "format": "uint",
          "default": 10000,
          "minimum": 0
        },
        "job_result_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 536870912,
          "minimum": 0
        },
        "job_retention_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 604800,
          "minimum": 0
        },
        "job_timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 0
        },
        "json_grid_values": {
          "type": "integer",
          "format": "uint",
          "default": 250000,
          "minimum": 0
        },
        "light_concurrency": {
          "type": "integer",
          "format": "uint",
          "default": 32,
          "minimum": 0
        },
        "points_per_query": {
          "type": "integer",
          "format": "uint",
          "default": 100,
          "minimum": 0
        },
        "queued_jobs": {
          "type": "integer",
          "format": "uint",
          "default": 64,
          "minimum": 0
        },
        "reader_cache_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 268435456,
          "minimum": 0
        },
        "request_body_bytes": {
          "type": "integer",
          "format": "uint",
          "default": 2097152,
          "minimum": 0
        },
        "response_cache_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 134217728,
          "minimum": 0
        },
        "sync_result_values": {
          "type": "integer",
          "format": "uint",
          "default": 2000000,
          "minimum": 0
        },
        "sync_timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 10,
          "minimum": 0
        },
        "temporal_frames": {
          "type": "integer",
          "format": "uint",
          "default": 120,
          "minimum": 0
        },
        "temporal_output_values": {
          "description": "Fixed and dynamic values allowed in an asynchronous temporal result.",
          "type": "integer",
          "format": "uint",
          "default": 32000000,
          "minimum": 0
        },
        "temporal_reduction_cells": {
          "description": "Native-domain cells allowed for an asynchronous temporal reduction.",
          "type": "integer",
          "format": "uint",
          "default": 4000000,
          "minimum": 0
        },
        "variables_per_query": {
          "type": "integer",
          "format": "uint",
          "default": 32,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "LogFormat": {
      "type": "string",
      "enum": [
        "json",
        "pretty"
      ]
    },
    "LoggingConfig": {
      "type": "object",
      "properties": {
        "filter": {
          "type": "string",
          "default": "rw_server=info,tower_http=info"
        },
        "format": {
          "$ref": "#/$defs/LogFormat",
          "default": "json"
        }
      },
      "additionalProperties": false
    },
    "PromotionConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "maximum_object_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 67108864,
          "minimum": 0
        },
        "minimum_hits": {
          "type": "integer",
          "format": "uint64",
          "default": 3,
          "minimum": 0
        },
        "window_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ServerConfig": {
      "type": "object",
      "properties": {
        "allow_unauthenticated_public_bind": {
          "type": "boolean",
          "default": false
        },
        "artifact_root": {
          "type": "string",
          "default": "./artifacts"
        },
        "cors_origins": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "listen": {
          "type": "string",
          "default": "127.0.0.1:8788"
        },
        "store_root": {
          "type": "string",
          "default": "./store"
        }
      },
      "additionalProperties": false
    }
  }
}
